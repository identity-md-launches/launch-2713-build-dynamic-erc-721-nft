{
  "name": "squeek-companion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/compile.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:contract": "node --test tests/contract.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "test:live": "node scripts/check-live.mjs",
    "social": "node scripts/social.mjs",
    "compile": "node scripts/compile.mjs",
    "status:calldata": "node scripts/status-calldata.mjs",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@coinbase/wallet-sdk": "^4.4.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@tanstack/react-query": "^5.105.0",
    "lucide-react": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "viem": "^2.57.13",
    "wagmi": "^3.7.9"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "solc": "0.8.26",
    "typescript": "^5.9.3",
    "vite": "^7.3.7"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
